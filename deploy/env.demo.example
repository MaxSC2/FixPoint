# Copy this file to .env on the VPS and replace every CHANGE_ME value.
# Never commit the real .env file or share it in screenshots/logs.

APP_NAME=FixPoint
APP_ENV=staging
APP_DEBUG=false
DEMO_DOMAIN=fixpoint-demo.example.invalid
APP_URL=https://fixpoint-demo.example.invalid
APP_TIMEZONE=Asia/Almaty

# The app container is bound only to the VPS loopback; public traffic goes through Caddy.
APP_PORT=127.0.0.1:8080

DB_DATABASE=fixpoint_demo
DB_USERNAME=fixpoint_app
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_ROOT_PASSWORD=CHANGE_ME_DB_ROOT_PASSWORD
DB_CHARSET=utf8mb4

SESSION_NAME=fixpoint_demo_session
SESSION_LIFETIME=120
SESSION_SECURE=true
SESSION_SAMESITE=Lax

# One seed password is used for the demo accounts created by the seeder.
# Keep it private; do not publish the admin account password.
SEED_PASSWORD=CHANGE_ME_DEMO_SEED_PASSWORD

RUN_MIGRATIONS=true
SEED_DATABASE=true
CATALOG_PER_PAGE=12
DB_WAIT_ATTEMPTS=60

CONTACT_ADDRESS=
CONTACT_PHONE=
CONTACT_EMAIL=
CONTACT_WORKING_HOURS=
