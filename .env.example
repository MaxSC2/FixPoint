# FixPoint — безопасные локальные значения. Скопируйте в .env и измените пароли.
# .env не отслеживается git и не должен попадать в репозиторий.

APP_NAME=FixPoint
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Almaty

# Только для docker compose: внешний порт приложения.
APP_PORT=8080

# Нативные запуски: 127.0.0.1. Docker Compose переопределяет DB_HOST на db.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fixpoint
DB_USERNAME=fixpoint
DB_PASSWORD=change_me_locally
DB_CHARSET=utf8mb4

# Только для docker compose: пароль root-пользователя контейнера MySQL.
DB_ROOT_PASSWORD=change_me_root_locally

SESSION_NAME=fixpoint_session
SESSION_LIFETIME=120
SESSION_SECURE=false
SESSION_SAMESITE=Lax

# Пароль локальных seed-аккаунтов. Никогда не использовать в production.
SEED_PASSWORD=FixPoint!Dev1

# Автоматические миграции/seed при старте контейнера.
RUN_MIGRATIONS=true
SEED_DATABASE=true

CATALOG_PER_PAGE=10

# Публичные контакты. Оставьте пустыми, пока нет согласованных реальных данных:
# шаблон покажет явный placeholder вместо вымышленного адреса или телефона.
CONTACT_ADDRESS=
CONTACT_PHONE=
CONTACT_EMAIL=
CONTACT_WORKING_HOURS=
